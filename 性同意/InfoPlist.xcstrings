        "en" : { "stringUnit" : { "state" : "translated", "value" : "Used to transfer encrypted video directly between two nearby devices without the developer's servers." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "開発者のサーバーを使わず、近くの2台のデバイス間で暗号化動画を直接転送します。" } }

        "en" : { "stringUnit" : { "state" : "translated", "value" : "Used to record your own video for a shared private record. It is not uploaded to the developer." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ふたりのプライベートな記録のために、ご自身の動画を撮影します。開発者にはアップロードしません。" } }
